{
  "compilerOptions": {
    /* Output dirs */
    "rootDir": "src",
    "outDir": "dist",

    /* Transpilation targets */
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",

    /* Enable ES-style imports in CJS */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Type checking */
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],

    /* Output enhancements */
    "sourceMap": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "drizzle.config.ts"]
}
