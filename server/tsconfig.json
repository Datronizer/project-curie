{
  "compilerOptions": {
    /* Output dirs */
    "rootDir": "src",
    "outDir": "dist",

    /* Transpilation targets */
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",

    /* Enable ES-style imports in CJS */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Type checking */
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],

    /* Output enhancements */
    "sourceMap": true
  },
  "include": ["src"]
}
